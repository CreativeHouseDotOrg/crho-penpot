# Copy to .env in the stack directory (default ~/repos/crho-penpot) and fill in the two secrets.
# Generate a key with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_VERSION=2.19.1
PENPOT_PUBLIC_URI=http://localhost:9101
PENPOT_PORT=9101
MAILPIT_PORT=8125
PENPOT_SECRET_KEY=
PENPOT_DB_PASSWORD=
